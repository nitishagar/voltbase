  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head"><div class="wrap">
      <a class="brand" href="/voltbase/"><span class="brand-glyph" aria-hidden="true">❯</span> voltbase</a>
      <nav aria-label="Docs"><ul>
        <li><a href="/voltbase/">Home</a></li>
